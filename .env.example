# Пример конфигурации для AI Agent Control Panel
# Скопируйте этот файл в .env и настройте значения

# ══════════════════════════════════════════════════════════════════════════════
# СЕКРЕТЫ — задаются как переменные окружения ОС, НЕ в этом файле!
# См. README.md → "Setting Environment Variables"
# ══════════════════════════════════════════════════════════════════════════════
#
# TELEGRAM_BOT_TOKEN   — Токен Telegram бота (обязательно)
# API_KEY              — Ключ API для AI сервера (опционально, по умолчанию из configDefaults.js)
# VITE_API_KEY         — Ключ API для авторизации запросов фронтенда (обязательно)
# OPENROUTER_API_KEY   — Ключ API для OpenRouter (опционально)

# ══════════════════════════════════════════════════════════════════════════════
# НЕСЕКРЕТНЫЕ НАСТРОЙКИ — безопасно хранить в .env
# ══════════════════════════════════════════════════════════════════════════════

# Имя модели для первого запуска без UI (опционально)
# MODEL_NAME=qwen3.5-2b

# Порт сервера (опционально)
# API_PORT=3000

# Базовый URL бэкенда (опционально, для фронтенда)
# VITE_API_BASE_URL=http://127.0.0.1:3000/api

# Путь к проекту (опционально)
# PROJECT_PATH=/path/to/your/project

# URL AI сервера (опционально)
# SERVER_URL=http://localhost:8080/v1

# Кастомный системный промпт (опционально)
# SYSTEM_PROMPT=Ты — умный ассистент...

# Настройки AI (опционально)
# MAX_TOKENS=1024
# TEMPERATURE=0.1
# TIMEOUT=300000

# CORS origin для прод-деплоя (опционально, по умолчанию "*" для локальной разработки)
# CORS_ORIGIN=https://your-domain.com

# Лимит ретраев для @grammyjs/auto-retry при Telegram 429/rate-limit (опционально, по умолчанию 3)
# MAX_RETRIES=3

# Удалённый ASR-сервер whisper.cpp (опционально, рекомендуется — экономит CPU/RAM/1.5 GB модели)
# ASR_SERVER_URL=http://localhost:9000/inference
# ASR_TIMEOUT=120000
