# Пример конфигурации для AI Agent Control Panel
# Скопируйте этот файл в .env и настройте значения

# --- Frontend (Vite) переменные ---
# Обязательная: API ключ для аутентификации запросов к бэкенду
# Установите уникальный ключ для вашего окружения
VITE_API_KEY=your-secret-api-key-here

# Опциональная: базовый URL бэкенда (если отличается от defaults)
# VITE_API_BASE_URL=http://127.0.0.1:3000/api

# --- Backend (Express) переменные ---
# Обязательная: токен вашего Telegram бота
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Опциональная: путь к проекту для контекста агента
# PROJECT_PATH=/path/to/your/project

# Опциональная: URL AI сервера
# SERVER_URL=http://localhost:8080/v1

# Опциональная: имя модели для первого запуска
# MODEL_NAME=qwen3.5-2b

# Опциональная: кастомный системный промпт
# SYSTEM_PROMPT=Ты — умный ассистент...

# --- Настройки AI ---
# MAX_TOKENS=8192
# TEMPERATURE=0.1
# TIMEOUT=120000

# Порт для API сервера
# API_PORT=3000