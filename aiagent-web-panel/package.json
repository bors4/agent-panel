{
  "name": "aiagent-web-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:generate": "jsdoc -c jsdoc.conf.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "pinia": "^3.0.4",
    "vue": "beta"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jsdoc": "^4.0.4",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.6"
  },
  "jsdoc": {
    "source": {
      "include": [
        "src",
        "../aiagent-be/lib",
        "../aiagent-be/routes",
        "../aiagent-be/server.js"
      ],
      "exclude": [
        "node_modules"
      ]
    },
    "opts": {
      "destination": "../docs",
      "template": "default",
      "verbose": true,
      "encoding": "utf8"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
